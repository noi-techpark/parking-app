{
  "title": "Parking App",
  "shortName": "parking-app",
  "description": "Showing the real time data and predictions of parking spaces.",
  "descriptionAbstract": "Parking spaces",
  "license": "AGPL-3.0-or-later",
  "repositoryUrl": "https://github.com/noi-techpark/parking-app.git",
  "copyrightHolders": [
    {
      "name": "NOI",
      "email": "info@noi.bz.it",
      "organization": "NOI AG/SpA Südtirol - Alto Adige",
      "organizationUrl": "https://noi.bz.it"
    }
  ],
  "authors": [
    {
      "name": "CodeWorks by FlashBeing",
      "email": "info@flashbeing.com",
      "organization": "FlashBeing s.r.l.",
      "organizationUrl": "https://codeworks.build"
    }
  ],
  "image": "wcs-logo.png",
  "searchTags": [
    "mobility",
    "map",
    "real time",
    "forecast"
  ],
  "dist": {
    "basePath": "dist",
    "files": [
      "bolzano-parking-app.min.js"
    ],
    "scripts": []
  },
  "configuration": {
    "tagName": "bolzano-parking-app",
    "options": [
      {
        "key": "municipalities",
        "type": "text",
        "label": "Show only these municipalities, comma-separated. Accepts the name in any language or the internal id, e.g. \"Bolzano - Bozen, Merano\" or \"Bozen, Meran\". Leave empty to show all.",
        "required": false,
        "options": {
          "default": ""
        }
      },
      {
        "key": "parkings",
        "type": "text",
        "label": "Show only these car parks, comma-separated station codes (e.g. \"103,105,112\"). This is how you build a fixed dashboard for one operator or district. Leave empty to show all.",
        "required": false,
        "options": {
          "default": ""
        }
      },
      {
        "key": "origins",
        "type": "text",
        "label": "Show only these data providers, comma-separated, e.g. \"FAMAS, GARDENA, SBB\". Leave empty to show all.",
        "required": false,
        "options": {
          "default": ""
        }
      },
      {
        "key": "status",
        "type": "text",
        "label": "Show only parkings with these statuses, comma-separated: live, delayed, static. Leave empty for all.",
        "required": false,
        "options": {
          "default": ""
        }
      },
      {
        "key": "filters",
        "type": "text",
        "label": "Which filters the visitor may change, comma-separated: municipality, parking, origin, status. Use \"none\" to hide the filter bar completely and lock the view to whatever the settings above define.",
        "required": false,
        "options": {
          "default": "municipality,parking,origin,status"
        }
      },
      {
        "key": "show-static",
        "type": "select",
        "label": "Include parkings that publish no live availability.",
        "required": false,
        "options": {
          "values": [
            "true",
            "false"
          ],
          "default": "true"
        }
      },
      {
        "key": "search",
        "type": "text",
        "label": "Preset the free-text search box.",
        "required": false,
        "options": {
          "default": ""
        }
      },
      {
        "key": "live-max-age",
        "type": "text",
        "label": "How recent a reading must be to count as real time, e.g. 30m, 2h.",
        "required": false,
        "options": {
          "default": "30m"
        }
      },
      {
        "key": "stale-max-age",
        "type": "text",
        "label": "Readings older than this are not shown at all, e.g. 6mo, 30d.",
        "required": false,
        "options": {
          "default": "6mo"
        }
      },
      {
        "key": "refresh-interval",
        "type": "text",
        "label": "How often to poll for new readings, e.g. 60s.",
        "required": false,
        "options": {
          "default": "60s"
        }
      },
      {
        "key": "language",
        "type": "select",
        "label": "Interface language.",
        "required": false,
        "options": {
          "values": [
            "en"
          ],
          "default": "en"
        }
      },
      {
        "key": "center",
        "type": "text",
        "label": "Override the initial map centre as \"lon,lat\". Empty fits the view to the data.",
        "required": false,
        "options": {
          "default": ""
        }
      },
      {
        "key": "zoom",
        "type": "number",
        "label": "Override the initial zoom level, 1-19 (used together with center).",
        "required": false,
        "options": {
          "default": 13
        }
      }
    ]
  }
}
